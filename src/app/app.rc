#include <windows.h>

// Embed app.manifest as RT_MANIFEST (id 1) so Windows uses our manifest
// (asInvoker / DPI / Win10-11 supportedOS) instead of a linker-generated default.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// Application icon. Windows uses the icon with the lowest resource id as the
// executable's icon, so keep this at 1.
1 ICON "app.ico"
